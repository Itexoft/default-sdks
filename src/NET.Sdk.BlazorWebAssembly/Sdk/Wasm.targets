<Project>
    <ItemGroup Condition="'$(WasmProfilers)' != ''">
        <_ItexoftWasmProfiler Include="$(WasmProfilers)"/>
        <_ItexoftWasmProfilerAot Include="@(_ItexoftWasmProfiler->WithMetadataValue('Identity','aot'))"/>
        <_ItexoftWasmProfilerBrowser Include="@(_ItexoftWasmProfiler->WithMetadataValue('Identity','browser'))"/>
        <_ItexoftWasmProfilerLog Include="@(_ItexoftWasmProfiler->WithMetadataValue('Identity','log'))"/>
    </ItemGroup>

    <PropertyGroup>
        <_ItexoftWasmProfilerAotCount>@(_ItexoftWasmProfilerAot->Count())</_ItexoftWasmProfilerAotCount>
        <_ItexoftWasmProfilerBrowserCount>@(_ItexoftWasmProfilerBrowser->Count())</_ItexoftWasmProfilerBrowserCount>
        <_ItexoftWasmProfilerLogCount>@(_ItexoftWasmProfilerLog->Count())</_ItexoftWasmProfilerLogCount>
    </PropertyGroup>

    <Target Name="ItexoftValidateWasmEnableThreads"
            BeforeTargets="AssignProjectConfiguration;ItexoftResolveRuntimeWasmPackageLayout">
        <Error Condition="'$(WasmEnableThreads)' != 'true' and '$(WasmEnableThreads)' != 'false'"
               Text="WasmEnableThreads must be explicitly set to true or false."/>
        <Error Condition="'$(_ItexoftWasmMainModuleLevelValue)' == ''"
               Text="WasmMainModuleLevel must be auto, main, dce, off, 0, 1, or 2."/>
        <Error Condition="'$(_ItexoftWasmDynamicLinkingEnabled)' == 'true' and '$(WasmEnableThreads)' == 'true' and !Exists('$(_ItexoftEmscriptenDylinkJsFixedFile)')"
               Text="The pthread-safe Emscripten dynamic-linking library is missing: $(_ItexoftEmscriptenDylinkJsFixedFile)"/>
    </Target>

    <!--
        Input: managed assemblies loaded by a host that accepts dynamically linked AOT modules.
        Output: the same assembly files copied through ILLink without rewriting their identities.
        Changed state: each assembly's ILLink action becomes copy.
        Correctness means every published assembly keeps the module identifier (MVID) recorded
        while compiling the side module.
    -->
    <Target Name="PreserveWasmDynamicLinkingAssemblyIdentity"
            AfterTargets="PrepareForILLink"
            BeforeTargets="_RunILLink"
            Condition="'$(_ItexoftWasmDynamicLinkingEnabled)' == 'true' and '$(PublishTrimmed)' == 'true'">
        <ItemGroup>
            <ManagedAssemblyToLink>
                <TrimMode>copy</TrimMode>
            </ManagedAssemblyToLink>
        </ItemGroup>
    </Target>

    <PropertyGroup Condition="'$(_ItexoftWasmDynamicLinkingEnabled)' == 'true'">
        <WasmBuildNative>true</WasmBuildNative>
        <ResolvePackageDependenciesForBuildDependsOn>
            $(ResolvePackageDependenciesForBuildDependsOn);
            ItexoftRewriteRuntimePackNativeAssets;
            ItexoftRewriteRuntimePackManagedAssets
        </ResolvePackageDependenciesForBuildDependsOn>
        <PrepareInputsForWasmBuildDependsOn>
            ItexoftUseRuntimeWasmNativeVariant;
            $(PrepareInputsForWasmBuildDependsOn)
        </PrepareInputsForWasmBuildDependsOn>
        <WasmGenerateAppBundleDependsOn>
            ItexoftUseRuntimeWasmNativeVariant;
            $(WasmGenerateAppBundleDependsOn)
        </WasmGenerateAppBundleDependsOn>
        <!-- Input: a multithreaded main-module link. Output: the pinned Emscripten dynamic-linking
             library whose side-module GOT.func values use per-thread-consistent table indices.
             Link inputs change; correctness means reverse P/Invoke reaches the same function-table
             slot on every pthread. -->
        <_ItexoftEmscriptenDylinkJsFixedFile>$([MSBuild]::NormalizePath($(MSBuildThisFileDirectory), 'js', 'library_dylink.js'))</_ItexoftEmscriptenDylinkJsFixedFile>
        <WasmCachePath Condition="'$(WasmCachePath)' == ''">$([MSBuild]::NormalizeDirectory($(BaseIntermediateOutputPath), 'emscripten-cache'))</WasmCachePath>
        <WasmCachePath Condition="'$(WasmCachePath)' == '$(EmscriptenCacheSdkCacheDir)'">$([MSBuild]::NormalizeDirectory($(BaseIntermediateOutputPath), 'emscripten-cache'))</WasmCachePath>
        <EmccExtraBitcodeCompilationFlags>$(EmccExtraBitcodeCompilationFlags) -fPIC</EmccExtraBitcodeCompilationFlags>
        <EmccExtraCFlags>$(EmccExtraCFlags) -fPIC -DWASM_SUPPORTS_DLOPEN=1</EmccExtraCFlags>
    </PropertyGroup>

    <ItemGroup Condition="'$(_ItexoftWasmDynamicLinkingEnabled)' == 'true'">
        <_MonoRuntimeComponentDontLink Include="libicudata.a;libicui18n.a;libicuuc.a;libSystem.Globalization.Native.a" Condition="'$(InvariantGlobalization)' == 'true'"/>
        <_MonoRuntimeComponentDontLink Include="libmono-profiler-aot.a" Condition="'$(_ItexoftWasmProfilerAotCount)' == '0'"/>
        <_MonoRuntimeComponentDontLink Include="libmono-profiler-browser.a" Condition="'$(_ItexoftWasmProfilerBrowserCount)' == '0'"/>
        <_MonoRuntimeComponentDontLink Include="libmono-profiler-log.a" Condition="'$(_ItexoftWasmProfilerLogCount)' == '0'"/>
        <LinkerArg Include="-s MAIN_MODULE=$(_ItexoftWasmMainModuleLevelValue)"/>
        <LinkerArg Include="-s NO_EXIT_RUNTIME=1"/>
        <LinkerArg Include="--js-library &quot;$(_ItexoftEmscriptenDylinkJsFixedFile)&quot;" Condition="'$(WasmEnableThreads)' == 'true'"/>
    </ItemGroup>

    <Target Name="ItexoftResolveRuntimeWasmPackageLayout"
            Condition="'$(_ItexoftWasmDynamicLinkingEnabled)' == 'true'">
        <Error Condition="'$(_ItexoftRuntimeWasmPackageRoot)' == ''"
               Text="Itexoft.dotnet.runtime.wasm package path is not resolved. Restore the package before building $(BrowserWasmRuntimeIdentifier) dynamic linking."/>
        <Error Condition="'$(_ItexoftRuntimeWasmNativeVariantDir)' == '' or !Exists('$(_ItexoftRuntimeWasmNativeVariantDir)')"
               Text="Itexoft.dotnet.runtime.wasm native variant directory is missing: $(_ItexoftRuntimeWasmNativeVariantDir)"/>
        <Error Condition="'$(_ItexoftRuntimeWasmManagedVariantDir)' == '' or !Exists('$(_ItexoftRuntimeWasmManagedVariantDir)')"
               Text="Itexoft.dotnet.runtime.wasm managed variant directory is missing: $(_ItexoftRuntimeWasmManagedVariantDir)"/>
        <Error Condition="!Exists('$([MSBuild]::NormalizePath($(_ItexoftRuntimeWasmNativeVariantDir), &quot;dotnet.js&quot;))')"
               Text="Itexoft.dotnet.runtime.wasm is missing dotnet.js in $(_ItexoftRuntimeWasmNativeVariantDir)."/>
        <Error Condition="!Exists('$([MSBuild]::NormalizePath($(_ItexoftRuntimeWasmNativeVariantDir), &quot;dotnet.runtime.js&quot;))')"
               Text="Itexoft.dotnet.runtime.wasm is missing dotnet.runtime.js in $(_ItexoftRuntimeWasmNativeVariantDir)."/>
        <Error Condition="!Exists('$([MSBuild]::NormalizePath($(_ItexoftRuntimeWasmNativeVariantDir), &quot;include&quot;, &quot;mono-2.0&quot;, &quot;mono&quot;, &quot;metadata&quot;, &quot;appdomain.h&quot;))')"
               Text="Itexoft.dotnet.runtime.wasm is missing include/mono-2.0/mono/metadata/appdomain.h in $(_ItexoftRuntimeWasmNativeVariantDir)."/>
        <Error Condition="!Exists('$([MSBuild]::NormalizePath($(_ItexoftRuntimeWasmNativeVariantDir), &quot;include&quot;, &quot;wasm&quot;, &quot;pinvoke.h&quot;))')"
               Text="Itexoft.dotnet.runtime.wasm is missing include/wasm/pinvoke.h in $(_ItexoftRuntimeWasmNativeVariantDir)."/>
        <Error Condition="!Exists('$([MSBuild]::NormalizePath($(_ItexoftRuntimeWasmNativeVariantDir), &quot;src&quot;, &quot;emcc-link.rsp&quot;))')"
               Text="Itexoft.dotnet.runtime.wasm is missing src/emcc-link.rsp in $(_ItexoftRuntimeWasmNativeVariantDir)."/>
    </Target>

    <Target Name="ItexoftUseRuntimeWasmNativeVariant"
            DependsOnTargets="_InitializeCommonProperties;ItexoftResolveRuntimeWasmPackageLayout"
            Condition="'$(_ItexoftWasmDynamicLinkingEnabled)' == 'true'">
        <PropertyGroup>
            <MicrosoftNetCoreAppRuntimePackRidNativeDir>$([MSBuild]::NormalizeDirectory('$(_ItexoftRuntimeWasmNativeVariantDir)'))</MicrosoftNetCoreAppRuntimePackRidNativeDir>
            <_WasmRuntimePackIncludeDir>$([MSBuild]::NormalizeDirectory('$(_ItexoftRuntimeWasmNativeVariantDir)', 'include'))</_WasmRuntimePackIncludeDir>
            <_WasmRuntimePackSrcDir>$([MSBuild]::NormalizeDirectory('$(_ItexoftRuntimeWasmNativeVariantDir)', 'src'))</_WasmRuntimePackSrcDir>
        </PropertyGroup>
    </Target>

    <Target Name="ItexoftRewriteRuntimePackNativeAssets"
            DependsOnTargets="ItexoftResolveRuntimeWasmPackageLayout"
            Condition="'$(_ItexoftWasmDynamicLinkingEnabled)' == 'true'">
        <ItemGroup>
            <_ItexoftRuntimePackNativeAssetCandidate Include="@(RuntimePackAsset)"
                                                    Condition="'%(RuntimePackAsset.AssetType)' == 'native'">
                <_ItexoftRuntimePackReplacementPath>$([MSBuild]::NormalizePath('$(_ItexoftRuntimeWasmNativeVariantDir)', '%(RuntimePackAsset.Filename)%(RuntimePackAsset.Extension)'))</_ItexoftRuntimePackReplacementPath>
            </_ItexoftRuntimePackNativeAssetCandidate>
            <_ItexoftRuntimePackNativeAssetToReplace Include="@(_ItexoftRuntimePackNativeAssetCandidate)"
                                                     Condition="Exists('%(_ItexoftRuntimePackNativeAssetCandidate._ItexoftRuntimePackReplacementPath)')"/>
            <_ItexoftRuntimePackNativeAssetReplacement Include="@(_ItexoftRuntimePackNativeAssetToReplace->'%(_ItexoftRuntimePackReplacementPath)')">
                <AssetType>%(_ItexoftRuntimePackNativeAssetToReplace.AssetType)</AssetType>
                <CopyLocal>%(_ItexoftRuntimePackNativeAssetToReplace.CopyLocal)</CopyLocal>
                <DestinationSubDirectory>%(_ItexoftRuntimePackNativeAssetToReplace.DestinationSubDirectory)</DestinationSubDirectory>
                <DestinationSubPath>%(_ItexoftRuntimePackNativeAssetToReplace.DestinationSubPath)</DestinationSubPath>
                <NuGetPackageId>%(_ItexoftRuntimePackNativeAssetToReplace.NuGetPackageId)</NuGetPackageId>
                <NuGetPackageVersion>%(_ItexoftRuntimePackNativeAssetToReplace.NuGetPackageVersion)</NuGetPackageVersion>
                <OriginalItemSpec>%(_ItexoftRuntimePackNativeAssetToReplace.OriginalItemSpec)</OriginalItemSpec>
                <PathInPackage>%(_ItexoftRuntimePackNativeAssetToReplace.PathInPackage)</PathInPackage>
                <RelativePath>%(_ItexoftRuntimePackNativeAssetToReplace.RelativePath)</RelativePath>
                <RuntimePackAlwaysCopyLocal>%(_ItexoftRuntimePackNativeAssetToReplace.RuntimePackAlwaysCopyLocal)</RuntimePackAlwaysCopyLocal>
                <Culture>%(_ItexoftRuntimePackNativeAssetToReplace.Culture)</Culture>
            </_ItexoftRuntimePackNativeAssetReplacement>
        </ItemGroup>

        <ItemGroup>
            <RuntimePackAsset Remove="@(_ItexoftRuntimePackNativeAssetToReplace)"/>
            <RuntimePackAsset Include="@(_ItexoftRuntimePackNativeAssetReplacement)"/>

            <ReferenceCopyLocalPaths Remove="@(_ItexoftRuntimePackNativeAssetToReplace)"/>
            <ReferenceCopyLocalPaths Include="@(_ItexoftRuntimePackNativeAssetReplacement)"
                                     Condition="'$(CopyLocalLockFileAssemblies)' == 'true' and ('$(SelfContained)' == 'true' or '%(_ItexoftRuntimePackNativeAssetReplacement.RuntimePackAlwaysCopyLocal)' == 'true') and '%(_ItexoftRuntimePackNativeAssetReplacement.AssetType)' != 'pgodata'"/>
        </ItemGroup>
    </Target>

    <!--
        Input: managed assets from the selected Microsoft runtime pack.
        Output: the same asset metadata pointing to the compatible managed runtime variant.
        Changed state: RuntimePackAsset and ReferenceCopyLocalPaths before publish inputs are formed.
        Correctness means ILLink and the browser bundle consume the assemblies used by side-module AOT.
    -->
    <Target Name="ItexoftRewriteRuntimePackManagedAssets"
            DependsOnTargets="ItexoftResolveRuntimeWasmPackageLayout"
            Condition="'$(_ItexoftWasmDynamicLinkingEnabled)' == 'true'">
        <ItemGroup>
            <_ItexoftRuntimePackManagedAssetCandidate Include="@(RuntimePackAsset)"
                                                     Condition="'%(RuntimePackAsset.AssetType)' == 'runtime'">
                <_ItexoftRuntimePackReplacementPath>$([MSBuild]::NormalizePath('$(_ItexoftRuntimeWasmManagedVariantDir)', '%(RuntimePackAsset.Filename)%(RuntimePackAsset.Extension)'))</_ItexoftRuntimePackReplacementPath>
            </_ItexoftRuntimePackManagedAssetCandidate>
            <_ItexoftRuntimePackManagedAssetToReplace Include="@(_ItexoftRuntimePackManagedAssetCandidate)"
                                                    Condition="Exists('%(_ItexoftRuntimePackManagedAssetCandidate._ItexoftRuntimePackReplacementPath)')"/>
            <_ItexoftRuntimePackManagedAssetReplacement Include="@(_ItexoftRuntimePackManagedAssetToReplace->'%(_ItexoftRuntimePackReplacementPath)')">
                <AssetType>%(_ItexoftRuntimePackManagedAssetToReplace.AssetType)</AssetType>
                <CopyLocal>%(_ItexoftRuntimePackManagedAssetToReplace.CopyLocal)</CopyLocal>
                <DestinationSubDirectory>%(_ItexoftRuntimePackManagedAssetToReplace.DestinationSubDirectory)</DestinationSubDirectory>
                <DestinationSubPath>%(_ItexoftRuntimePackManagedAssetToReplace.DestinationSubPath)</DestinationSubPath>
                <NuGetPackageId>%(_ItexoftRuntimePackManagedAssetToReplace.NuGetPackageId)</NuGetPackageId>
                <NuGetPackageVersion>%(_ItexoftRuntimePackManagedAssetToReplace.NuGetPackageVersion)</NuGetPackageVersion>
                <OriginalItemSpec>%(_ItexoftRuntimePackManagedAssetToReplace.OriginalItemSpec)</OriginalItemSpec>
                <PathInPackage>%(_ItexoftRuntimePackManagedAssetToReplace.PathInPackage)</PathInPackage>
                <RelativePath>%(_ItexoftRuntimePackManagedAssetToReplace.RelativePath)</RelativePath>
                <RuntimePackAlwaysCopyLocal>%(_ItexoftRuntimePackManagedAssetToReplace.RuntimePackAlwaysCopyLocal)</RuntimePackAlwaysCopyLocal>
                <Culture>%(_ItexoftRuntimePackManagedAssetToReplace.Culture)</Culture>
            </_ItexoftRuntimePackManagedAssetReplacement>
        </ItemGroup>

        <ItemGroup>
            <RuntimePackAsset Remove="@(_ItexoftRuntimePackManagedAssetToReplace)"/>
            <RuntimePackAsset Include="@(_ItexoftRuntimePackManagedAssetReplacement)"/>

            <ReferenceCopyLocalPaths Remove="@(_ItexoftRuntimePackManagedAssetToReplace)"/>
            <ReferenceCopyLocalPaths Include="@(_ItexoftRuntimePackManagedAssetReplacement)"
                                     Condition="'$(CopyLocalLockFileAssemblies)' == 'true' and ('$(SelfContained)' == 'true' or '%(_ItexoftRuntimePackManagedAssetReplacement.RuntimePackAlwaysCopyLocal)' == 'true') and '%(_ItexoftRuntimePackManagedAssetReplacement.AssetType)' != 'pgodata'"/>
        </ItemGroup>
    </Target>
</Project>
